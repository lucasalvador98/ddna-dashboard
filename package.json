    "dotenv": "^17.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.8.0",
    "mammoth": "^1.12.0",
    "next": "16.2.3",
    "openai": "^6.35.0",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
